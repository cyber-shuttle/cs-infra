[Unit]
Description=Apache Airavata Custos core
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=ubuntu
Group=ubuntu
EnvironmentFile=/etc/default/custos
WorkingDirectory=/opt/custos
ExecStart=/usr/local/bin/custos-server
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
