[Unit]
Description=Apache Airavata Custos core
After=postgresql.service

[Service]
User=ubuntu
EnvironmentFile=/etc/default/custos
# Upstream's config/custos.yaml reads these through ${VAR} substitution.
Environment=CONFIG_PATH=/opt/custos/custos.yaml
Environment=DATABASE_DSN=postgres:///cybershuttle?host=/var/run/postgresql&search_path=custos
Environment=OIDC_ISSUER_URL=https://cilogon.org
Environment=OIDC_AUDIENCE=cilogon:oa4mp,2012:/client_id/4738a93a9b45576c741063718d55143b
Environment=CUSTOS_TRACING_MODE=noop
WorkingDirectory=/opt/custos
# Custos binds every interface and cannot be told otherwise, so outside traffic to its port is dropped here.
ExecStartPre=+/bin/sh -c 'for t in iptables ip6tables; do $$t -C INPUT -p tcp --dport 8100 ! -i lo -j DROP 2>/dev/null || $$t -I INPUT -p tcp --dport 8100 ! -i lo -j DROP; done'
ExecStart=/usr/local/bin/custos-server
ExecStopPost=+/bin/sh -c 'for t in iptables ip6tables; do $$t -D INPUT -p tcp --dport 8100 ! -i lo -j DROP 2>/dev/null || true; done'
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
